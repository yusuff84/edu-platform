FROM node:20-slim
RUN apt-get -o Acquire::Retries=3 update && apt-get -o Acquire::Retries=3 install -y --no-install-recommends python3 bubblewrap \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 runner \
    && useradd --uid 10001 --gid runner --home-dir /tmp --shell /usr/sbin/nologin runner \
    && chmod 1777 /tmp
COPY artifacts/runner /usr/local/bin/runner
RUN chmod 0755 /usr/local/bin/runner
ENV HOME=/tmp LANG=C.UTF-8
USER runner:runner
WORKDIR /tmp
EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/runner"]
