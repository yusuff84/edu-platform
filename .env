# edu-platform — dev-окружение для docker compose up.
# Файл отслеживается git НАМЕРЕННО и содержит только несекретные dev-значения
# (см. README, раздел «Окружение»). Для прода используйте свой env-file:
#   docker compose --env-file .env.prod up -d
DATABASE_URL=postgres://edu:edu@db:5432/edu?sslmode=disable
SESSION_SECRET=change-me
APP_ENV=development
PAYMENTS_PROVIDER=mock
COMMISSION_PCT=15
PORT=8080
RUNNER_URL=http://runner:8081
# Для локального npm run dev без docker (в docker-сборке не используется):
VITE_API_URL=http://localhost:8082/api/v1
