# edu-platform — шаблон окружения. Скопируйте в .env перед запуском:
#   cp .env.example .env
# Значения по умолчанию взяты из кода (backend/internal/config/config.go,
# backend/internal/payments/*), а не выдуманы.

# ---- База и запуск ----

# Параметры Postgres для docker compose (dev-дефолты). Если меняете их,
# обновите и DATABASE_URL — DSN должен указывать на те же креды/БД.
POSTGRES_USER=edu
POSTGRES_PASSWORD=edu
POSTGRES_DB=edu
# DSN Postgres. В production обязателен: без него API не стартует (fail-fast),
# а не переключается молча в in-memory. В dev пустой/недоступный DSN →
# in-memory без сохранности (данные теряются при перезапуске).
DATABASE_URL=postgres://edu:edu@db:5432/edu?sslmode=disable
# Подпись сессионных cookie (HMAC-SHA256). Пусто или "change-me" допустимы
# ТОЛЬКО в dev; в production (APP_ENV=production) с таким значением старт
# запрещён. Сгенерируйте случайный секрет, например: openssl rand -hex 32.
SESSION_SECRET=change-me
# development | production. В docker compose по умолчанию development.
# Пусто вне compose — дедукция по DATABASE_URL (задан → production).
# Production запускайте с явным env-file:
#   docker compose --env-file .env.production up -d --build
APP_ENV=development
# Порт API внутри процесса/контейнера. Compose публикует его на 8082 хоста.
PORT=8080
# Каталог SQL-миграций (override). Пусто — авто-поиск относительно бинаря.
MIGRATIONS_DIR=

# ---- Оплата ----

# mock | stripe | yookassa. Дефолт для локального compose: mock.
# mock разрешён только в dev (APP_ENV=development); в production старт с mock
# запрещён, задайте stripe/yookassa и их ключи.
PAYMENTS_PROVIDER=mock
# Для production без приёма оплаты: PAYMENTS_PROVIDER=disabled.
# Бесплатные курсы доступны, платные покупки отклоняются без создания платежа.
# Комиссия платформы 0..90 (%). Дефолт: 15. При работающей БД может быть
# переопределена админом через PUT /api/v1/admin/settings (таблица app_settings).
COMMISSION_PCT=15
# Stripe (обязателен при PAYMENTS_PROVIDER=stripe — иначе «провайдер не настроен»).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# YooKassa (обязателен при PAYMENTS_PROVIDER=yookassa).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# CIDR/IP доверенных источников вебхуков YooKassa через запятую. Пусто — проверка
# источника выключена; непустое, но невалидное значение отклоняет все вебхуки.
YOOKASSA_TRUSTED_IPS=
# Только dev: если задан — mock-вебхук требует заголовок X-Mock-Signature
# (hex HMAC-SHA256 по телу). В production mock-провайдер запрещён целиком.
MOCK_WEBHOOK_SECRET=
# Абсолютный URL возврата после оплаты (Stripe/YooKassa). Дефолт: http://localhost:3000/
PAYMENTS_RETURN_URL=

# ---- Безопасность аутентификации (T10) ----

# SameSite сессионной cookie: lax | strict | none. Дефолт: lax.
COOKIE_SAMESITE=lax
# true — разрешить не-GET запросы без Origin/Referer (нужно локальным qa-скриптам
# в прод-режиме). Дефолт: false (жёсткий CSRF).
CSRF_ALLOW_MISSING_ORIGIN=false
# Rate-limit запросов в минуту на IP; 0 или отрицательное — лимит выключен.
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_WEBHOOK_PER_MIN=120

# ---- Приглашения учителей: ссылка и SMTP (опционально) ----

# База для ссылок в письмах. Должна совпадать с публичным адресом фронтенда.
PUBLIC_APP_URL=http://localhost:3000
# SMTP для отправки приглашений. Пусто — письма не отправляются, админ
# получает inviteLink/token в API и UI. TLS: starttls (587), implicit (465)
# или none (локальный MailHog/тестовый сервер; в production запрещён).
SMTP_ADDR=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=starttls

# ---- Яндекс OAuth (T10/T13) ----

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Должен совпадать с Redirect URI, зарегистрированным в Яндекс OAuth-приложении.
YANDEX_REDIRECT_URI=

# ---- Прочее ----

# CORS: источники через запятую. Дефолт: http://localhost:3000, http://127.0.0.1:3000.
ALLOWED_ORIGINS=
# URL песочницы исполнения кода. Дефолт: http://runner:8081.
RUNNER_URL=http://runner:8081
# Bootstrap-учётки: создаются только если заданы ОБЕ переменные пары.
# Пароль хешируется bcrypt при старте API. Дефолтных teacher@local/teacher1
# и admin@local нет ни в dev, ни в production. Существующему пользователю
# пароль не перезаписывается (исключение — невалидный bcrypt-хеш старой
# сид-миграции). В dev демо-данные (demo-teacher@local/teach1234 и курс)
# создаются отдельным dev-only сидом, не через эти переменные.
ADMIN_EMAIL=
ADMIN_PASSWORD=
TEACHER_EMAIL=
TEACHER_PASSWORD=

# ---- Только для локального npm run dev (не читается backend/compose) ----

# Базовый URL API для фронтенда. В docker-сборке не нужен (nginx проксирует
# /api → api:8080); в dev-сервере Vite сам проксирует /api на localhost:8082
# (см. VITE_API_PROXY в frontend/vite.config.ts).
VITE_API_URL=http://localhost:8082/api/v1

# Explicit proxy IPs/CIDRs allowed to supply client IP headers. Empty = trust none.
# Set this to the actual reverse-proxy address/subnet in your deployment.
TRUSTED_PROXY_CIDRS=
