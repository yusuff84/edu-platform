# edu-platform — шаблон окружения. Скопируйте в .env перед запуском:
#   cp .env.example .env
# Значения по умолчанию взяты из кода (backend/internal/config/config.go,
# backend/internal/payments/*), а не выдуманы.

# ---- База и запуск ----

# DSN Postgres. Пусто (или недоступная БД) → in-memory режим без сохранности.
# В проде обязателен, иначе все данные теряются при рестарте.
DATABASE_URL=postgres://edu:edu@db:5432/edu?sslmode=disable
# Подпись сессионных cookie (HMAC-SHA256). Пусто или "change-me" — только dev:
# в продовом режиме пустой секрет запрещает старт (см. config.Load).
SESSION_SECRET=change-me
# development | production. Пусто — дедукция по DATABASE_URL (задан → прод).
APP_ENV=development
# Порт API внутри процесса/контейнера. Compose публикует его на 8082 хоста.
PORT=8080
# Каталог SQL-миграций (override). Пусто — авто-поиск относительно бинаря.
MIGRATIONS_DIR=

# ---- Оплата ----

# mock | stripe | yookassa. Дефолт: mock.
PAYMENTS_PROVIDER=mock
# Комиссия платформы 0..90 (%). Дефолт: 15. При работающей БД может быть
# переопределена админом через PUT /api/v1/admin/settings (таблица app_settings).
COMMISSION_PCT=15
# Stripe (обязателен при PAYMENTS_PROVIDER=stripe — иначе «провайдер не настроен»).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# YooKassa (обязателен при PAYMENTS_PROVIDER=yookassa).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# CIDR/IP доверенных источников вебхуков YooKassa через запятую. Пусто — проверка источника выключена.
YOOKASSA_TRUSTED_IPS=
# Если задан — mock-вебхук требует заголовок X-Mock-Signature (hex HMAC-SHA256 по телу).
MOCK_WEBHOOK_SECRET=
# Абсолютный URL возврата после оплаты (Stripe/YooKassa). Дефолт: http://localhost:3000/
PAYMENTS_RETURN_URL=

# ---- Безопасность аутентификации (T10) ----

# SameSite сессионной cookie: lax | strict | none. Дефолт: lax.
COOKIE_SAMESITE=lax
# true — разрешить не-GET запросы без Origin/Referer (нужно локальным qa-скриптам
# в прод-режиме). Дефолт: false (жёсткий CSRF).
CSRF_ALLOW_MISSING_ORIGIN=false
# Rate-limit запросов в минуту на IP; 0 или отрицательное — лимит выключен.
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_WEBHOOK_PER_MIN=120

# ---- Приглашения учителей: ссылка и SMTP (опционально) ----

# База для ссылок в письмах. Должна совпадать с публичным адресом фронтенда.
PUBLIC_APP_URL=http://localhost:3000
# SMTP для отправки приглашений. Пусто — письма не отправляются, админ
# получает inviteLink/token в API и UI. TLS: starttls (587), implicit (465)
# или none (локальный MailHog/тестовый сервер).
SMTP_ADDR=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=starttls

# ---- Яндекс OAuth (клиент T10; эндпоинты подключает T13) ----

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Должен совпадать с Redirect URI, зарегистрированным в Яндекс OAuth-приложении.
YANDEX_REDIRECT_URI=

# ---- Прочее ----

# CORS: источники через запятую. Дефолт: http://localhost:3000, http://127.0.0.1:3000.
ALLOWED_ORIGINS=
# URL песочницы исполнения кода. Дефолт: http://runner:8081.
RUNNER_URL=http://runner:8081
# Опциональный сид админа: создаётся только если заданы ОБЕ переменные
# и email ещё не существует. Пароль хешируется bcrypt при старте API.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Только для локального npm run dev (не читается backend/compose) ----

# Базовый URL API для фронтенда. В docker-сборке не нужен (nginx проксирует
# /api → api:8080); в dev-сервере Vite сам проксирует /api на localhost:8082
# (см. VITE_API_PROXY в frontend/vite.config.ts).
VITE_API_URL=http://localhost:8082/api/v1
